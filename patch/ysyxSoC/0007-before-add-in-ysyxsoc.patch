+base_dir = $(abspath ..)
+
+CXXSRCS := comlog float_fix
+CXXFLAGS := $(CXXFLAGS) -std=c++11 -Wall
+
+OBJS := $(addsuffix .o,$(CXXSRCS))
+PROGRAMS := $(CXXSRCS)
+
+all: $(PROGRAMS)
+
+%: %.o
+	$(CXX) $< $(LDFLAGS) -o $@
+
