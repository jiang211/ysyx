+                if (LSU_AXI4_AWVALID && LSU_AXI4_WVALID) begin
+                    // Latch read address
+                    write_addr_reg <= LSU_AXI4_AWADDR;
+                    write_data <= LSU_AXI4_WDATA;
+                    wirte_wstrb <= LSU_AXI4_WSTRB;
