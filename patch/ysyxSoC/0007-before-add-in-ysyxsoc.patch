+    IDU_EXU_sh                  <=        1'b0;
+    IDU_EXU_csw                 <=        1'b0;  
+    IDU_EXU_csc                 <=        1'b0;
+    IDU_EXU_css                 <=        1'b0;    
+    IDU_EXU_ebreak              <=        1'b0;
+    IDU_EXU_ecall               <=        1'b0;     
+    IDU_EXU_mret                <=        1'b0;   
