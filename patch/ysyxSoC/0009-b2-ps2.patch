+}
+/* User application portal */
+int rt_application_init()
+{
+    int result;
+    struct mq_attr mqstat;
+    int oflag = O_CREAT|O_RDWR;
+#define MSG_SIZE    128
+#define MAX_MSG        128
+    memset(&mqstat, 0, sizeof(mqstat));
+    mqstat.mq_maxmsg = MAX_MSG;
