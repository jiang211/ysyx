diff --git a/abstract-machine/am/src/riscv/ysyxSoC/uart.c b/abstract-machine/am/src/riscv/ysyxSoC/uart.c
new file mode 100644
index 0000000..6cdede8
--- /dev/null
+++ b/abstract-machine/am/src/riscv/ysyxSoC/uart.c
@@ -0,0 +1,18 @@
+#include <am.h>
+#include <riscv/riscv.h>
+#define UART_BASE 0x10000000L
+#define UART_TX   0
+#define UART_dL1   0
+#define UART_dL2   1
+#define UART_FC   2
+#define UART_LC   3
+#define UART_LS   5
+
+void __am_uart_rx(AM_UART_RX_T *rx){
+    if((*(volatile uint8_t  *)(UART_BASE + UART_LS) & 0x1) == 0x1){
+        rx->data = *(volatile uint8_t  *)(UART_BASE );
+    }
+    else {
+        rx->data = 0xff;
+    }
+}
\ No newline at end of file
