+
+    while (1)
+    {
+       for (i = 0; i < 10; i++)
+        {
+            buf[sizeof(buf) - 2] = '0' + i;
+
+            printf("thread3 send [%s]\n", buf);
+            /* Send messages to the message queue */
+            result = mq_send(mqueue, &buf[0], sizeof(buf), 0);
+            if (result == -1)
+            {
+                /* Message queue full, delayed 1s */
