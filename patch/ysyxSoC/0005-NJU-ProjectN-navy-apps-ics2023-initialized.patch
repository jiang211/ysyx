+
+#define FOREACH_EVENT(_) \
+  _("t", timer) \
+  _("ku", keyup) \
+  _("kd", keydown) \
+  _("A-GRAVE", switch_window) \
+  _("A-UP", moveup_window) \
+  _("A-DOWN", movedown_window) \
+  _("A-LEFT", moveleft_window) \
+  _("A-RIGHT", moveright_window) \
+  _("A-R", appfinder) \
+
+class Window {
+protected:
