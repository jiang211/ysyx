+} default_apps [] = {
+  { "Terminal", nterm_argv[0], nterm_argv },
+  { "NSlider", nslider_argv[0], nslider_argv },
+  { "Typing Game", typing_argv[0], typing_argv },
+  { "FCEUX", fceux_argv[0], fceux_argv },
+  { "NPlayer", nplayer_argv[0], nplayer_argv },
+  { "Pal", pal_argv[0], pal_argv },
