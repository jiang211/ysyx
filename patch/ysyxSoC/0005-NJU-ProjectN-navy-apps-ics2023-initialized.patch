+
+  int x, y, w, h; // upper-left position (x, y) and window size (w * h)
+  int fw, fh, dx, dy; // frame buffer size (fw * fh) and offset (dx, dy)
+
+  int read_fd, write_fd; // IPC file descriptors. read_fd must be non-blocking
