+  reg [31:0] data[0:2 ** 21-1];
+  integer i;
+  reg sync_reg;
+
+  localparam h_frontporch = 96;
+  localparam h_active = 144;
+  localparam h_backporch = 784;
+  localparam h_total = 800;
+
+  localparam v_frontporch = 2;
+  localparam v_active = 35;
+  localparam v_backporch = 515;
+  localparam v_total = 525;
+
+  reg [9:0] x_cnt;
+  reg [9:0] y_cnt;
+  reg [20:0] counter;
+  wire h_valid;
+  wire v_valid;
+
+  always @(posedge clock) begin
+    if (reset == 1'b1) begin
+      x_cnt <= 0;
+    end else begin
+      if (x_cnt == h_total) begin
+        if (y_cnt == v_total) begin  //完成一次传输等待sync_reg
+          x_cnt <= 0;
+        end else begin
+          x_cnt <= 1;
+        end
+      end else if (x_cnt > 0) begin
+        x_cnt <= x_cnt + 1;
+      end else begin
+        if (sync_reg) begin
+          x_cnt <= 1;
+        end
+      end
+    end
+  end
+
+  always @(posedge clock) begin
+    if (reset == 1'b1) begin
+      y_cnt <= 1;
+    end else begin
+      if (x_cnt == h_total) begin
