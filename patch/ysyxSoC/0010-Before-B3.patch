 void __am_input_keybrd(AM_INPUT_KEYBRD_T *kbd) {
-  kbd->keydown = 0;
+  static bool is_break = false;
+  static bool extend = false;
+  uint8_t scancode = inb(PS2_ADDR + PS2_KBD_REG_SCANCODE);
+
+  kbd->keydown = false;
   kbd->keycode = AM_KEY_NONE;
+
+  if (scancode == 0xe0) {
+    extend = true;
+  } else if (scancode == 0xf0) {
+    is_break = true;
+  } else if (scancode != 0x0) {
+    kbd->keydown = !is_break;
+    kbd->keycode = extend ? SCANCODE_EXT[scancode] : SCANCODE[scancode];
+    extend = false;
+    is_break = false;
+  }
 }
