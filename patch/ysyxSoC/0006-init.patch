     Event ev = {0};
     switch (c->mcause) {
-      case 11: ev.event = EVENT_YIELD;break;
+      case 11: 
+        if(c->GPR1 == -1) {ev.event = EVENT_YIELD; c->mepc += 4;}
+        else ev.event = EVENT_SYSCALL;
+        break;
