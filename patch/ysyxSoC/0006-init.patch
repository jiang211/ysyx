-  return NULL;
+  Context *cp = (Context *)(kstack.end - sizeof(Context));
+  cp->mepc = (uintptr_t)entry;
+  cp->mstatus = 0x1800;
+  cp->gpr[10] = (uintptr_t)(arg);
+  return cp;
 }
 
 void yield() {
