+int fs_open(const char *pathname, int flags, int mode){
+  int len = sizeof(file_table)/sizeof(Finfo);
+  for(int i=0; i<len; i++){
+    if(strcmp(file_table[i].name, pathname) == 0){
+      file_table[i].open_offset = 0;
+      return i;
+    }
+  }
+  printf("file %s not found\n", pathname);
+  assert(0);
+  return -1;
+}
+size_t fs_read(int fd, void *buf, size_t len){
+  if (fd < 3) {
+    return 0;
+  }
+  if(file_table[fd].read != NULL) {
+    return file_table[fd].read(buf, 0, len);
+  }
+  size_t size = file_table[fd].size;
+  size_t offset = file_table[fd].open_offset;
+  size_t read_len = len;
+  if(offset + len > size)
+    read_len = size - offset;
+  if(read_len == 0)
+    return 0;
+  int ret = ramdisk_read(buf, file_table[fd].disk_offset + offset,read_len);
+  file_table[fd].open_offset += ret;
+  return ret;
 }
+size_t fs_write(int fd, const void *buf, size_t len){
+  if (file_table[fd].write == fb_write) {
+    if( file_table[fd].open_offset + len > file_table[fd].size) {
+      len = file_table[fd].size - file_table[fd].open_offset;
+    }
+    size_t offset = file_table[fd].open_offset ;
+    file_table[fd].open_offset = file_table[fd].open_offset + len ;
+    return file_table[fd].write(buf, offset, len);
+  }
+  else if (file_table[fd].write != NULL) {
+    return file_table[fd].write(buf, 0, len);
+  }
+  size_t size = file_table[fd].size;
+  size_t offset = file_table[fd].open_offset;
+  size_t write_len = len;
+  if(offset + len > size)
+    write_len = size - offset;
+  if(write_len == 0)
+    return 0;
+  int ret = ramdisk_write(buf, file_table[fd].disk_offset + offset,write_len);
+  file_table[fd].open_offset += ret;
+  return ret;
+}
+
+
+size_t fs_lseek(int fd, size_t offset, int whence){
+  if (fd < 3) {
+    return 0;
+  }
+  size_t size = file_table[fd].size;
+  switch(whence){
+    case SEEK_SET:
+      file_table[fd].open_offset = offset;
+      break;
+    case SEEK_CUR:
+      file_table[fd].open_offset += offset;
+      break;
+    case SEEK_END:
+      file_table[fd].open_offset = size + offset;
+      break;
+    default:
+      printf("invalid whence\n");
+      assert(0);
+  }
+  return file_table[fd].open_offset;
+
+}
+int fs_close(int fd){
+  return 0;
+}
