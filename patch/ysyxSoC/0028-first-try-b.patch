+
+    IDU_EXU_exu_raw_rs1           <=        IDU_EXU_exu_raw_rs1;
+    IDU_EXU_exu_raw_rs2           <=        IDU_EXU_exu_raw_rs2;
+    IDU_EXU_lsu_raw_rs1           <=        IDU_EXU_lsu_raw_rs1;
+    IDU_EXU_lsu_raw_rs2           <=        IDU_EXU_lsu_raw_rs2;
+    end
+end
+
+
+endmodule
