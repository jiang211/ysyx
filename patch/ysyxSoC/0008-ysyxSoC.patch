diff --git a/abstract-machine/scripts/ysyxSoclinker.ld b/abstract-machine/scripts/ysyxSoclinker.ld
new file mode 100644
index 0000000..af30420
--- /dev/null
+++ b/abstract-machine/scripts/ysyxSoclinker.ld
@@ -0,0 +1,48 @@
+ENTRY(_start)
+PHDRS { text PT_LOAD; data PT_LOAD; } 
+
+MEMORY {
+  mrom : ORIGIN = 0x20000000, LENGTH = 4K
+  sram : ORIGIN = 0x0f000000, LENGTH = 8K
+}
+
+SECTIONS {
+  /* _pmem_start and _entry_offset are defined in LDFLAGS */
+  . = ORIGIN(mrom);
+  .text : {
+    *(entry)
+    *(.text*)
+  } > mrom AT> mrom : text
+  etext = .;
+  _etext = .;
+  .rodata : {
+    .srodata = .;
+    *(.rodata*)
+    *(.srodata*)
+    .erodata = .;
+  } > mrom AT> mrom
+  _data_lma_start = LOADADDR(.rodata) + SIZEOF(.rodata);
+  . = ORIGIN(sram);
+  .data : {
+    _sdata = .;      /* SRAM中数据起始地址 (VMA) */
+    *(.data*)
+    *(.sdata*)
+    _edata = .;      /* SRAM中数据结束地址 (VMA) */
+  } > sram AT> mrom : data
+  _sidata = _data_lma_start; /* MROM中初始数据地址 (LMA) */
+  edata = .;
+  _data = .;
+  .bss : {
+	_bss_start = .;
+    *(.bss*)
+    *(.sbss*)
+    *(.scommon)
+  } > sram AT> mrom
+  _stack_top = ALIGN(0x10);
+  . = _stack_top + 0x800;
+  _stack_pointer = .;
+  end = .;
+  _end = .;
+  _heap_start = ALIGN(0x10);
+  _heap_end = _heap_start + 0x400;
+}
