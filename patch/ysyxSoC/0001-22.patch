diff --git a/nemu/src/isa/mips32/init.c b/nemu/src/isa/mips32/init.c
new file mode 100644
index 0000000..026760b
--- /dev/null
+++ b/nemu/src/isa/mips32/init.c
@@ -0,0 +1,42 @@
+/***************************************************************************************
+* Copyright (c) 2014-2022 Zihao Yu, Nanjing University
+*
