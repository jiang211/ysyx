+int sprintf(char *str, const char *fmt, ...)
+{
+  memset(str, 0, strlen(str));
+  const char *s;
+  char buf[17];
+  int d,x;
+  va_list ap;
+  int i = 0;
+  va_start(ap, fmt);
+
+  while (*fmt)
+  {
+    if (*fmt == '%')
+    {
+      switch (*++fmt)
+      {
+      case 's':
+        s = va_arg(ap, const char *); 
+        for (; *s; s++)
+        {
+          *str++ = *s;
+        }
+        fmt++;
+        break;
+      case 'd':
+        d = va_arg(ap, int);
+        sky_itoa(d, buf, 10);
+        for (s = buf; *s; s++)
+        {
+          *str++ = *s;
+        }
+        fmt++;
+        break;
+      case 'x':
+        x = va_arg(ap, int);
+        sky_itoa(x, buf, 16);
+        for (s = buf; *s; s++)
+        {
+          *str++ = *s;
+        }
+        fmt++;
+        break;
+      }
+    }
+    else
+    {
+      *str++ = *fmt++;
+    }
+    i++;
+  }
+  str[i] = '\0';
+ 
+  return i;
+}
