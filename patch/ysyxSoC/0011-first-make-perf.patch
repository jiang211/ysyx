+  
+  reg [31:0] count;
+  reg [1:0] state;
+  parameter IDLE = 2'b00, WAIT = 2'b01, DELAY = 2'b10;
+  always @(posedge clock) begin
+    if(reset) begin
+      count <= 0;
+      state <= IDLE;
+    end
+    else begin
+      case(state)
+        IDLE: begin
+          if(in_psel) begin
+            state <= WAIT;
+            count <= count + 32'd140;
+          end
+        end
+        WAIT: begin
+          if(out_pready) begin
+            state <= DELAY;
+            count <= (count + 32'd140) >> 5;
+          end
+          else begin
+            count <= count + 32'd140;
+          end
+        end
+        DELAY: begin
+          if(count == 1) begin
+            state <= IDLE;
+            count <= 0;
+          end
+          else begin
+            count <= count - 1;
+          end
+        end
+        default : state <= IDLE;
+      endcase
+    end
+  end
+  reg [31:0] rdata_cache;
+  reg        slver_cache;
+  always @(posedge clock) begin
+    if(reset) begin
+      rdata_cache <= 32'b0;
+      slver_cache <= 1'b0;
+    end else if(out_pready) begin
+      rdata_cache <= out_prdata;
+      slver_cache <= out_pslverr;
+    end
+  end
+
+  assign in_pready = (state == DELAY && count == 32'd1);
+  assign in_prdata = (state == DELAY && count == 32'd1) ? rdata_cache : 32'b0;
+  assign in_pslverr = (state == DELAY && count == 32'd1) ? slver_cache : 1'b0;
 endmodule
